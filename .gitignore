# Базовый .gitignore каркаса.
# Копируется в корень проекта и дополняется под его стек.

# --- Секреты и локальное окружение -----------------------------------------
.env
.env.*
*.pem
*.key
*_rsa
secrets.json
credentials.json
*.keystore

# --- Данные приложения ------------------------------------------------------
# Каталог с настройками, историей, кешем и логами: содержит ключи пользователя.
data/
*.log

# --- Файлы приватного каркаса -----------------------------------------------
# Решение человека от 2026-10-05: в публичный репозиторий идут ТОЛЬКО
# README.md и CHANGELOG.md. Остальное — строго приватно.
# AGENT.md в списке намеренно: в нём абсолютные пути и правила работы.
AGENT.md
prompt.md
DEVLOG.md
STATUS.md
TODO.md
BACKLOG.md
ROADMAP.md
DECISIONS.md
ARCHITECTURE.md
QUALITY.md
GLOSSARY.md
templates/
scripts/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node --------------------------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- IDE и редакторы --------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --- ОС ----------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Служебное ---------------------------------------------------------------
*.tmp
*.bak
*.orig
*.rej
tmp/
temp/